{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:sim": "python -m backend.simulator.run_simulation --duration 24h --interval 5",
    "dev:scheduler": "python -m backend.services.scheduler --mode continuous",
    "test": "pytest backend/tests/ -v",
    "test:24h": "python -m backend.tests.test_24h_simulation",
    "lint": "ruff check backend/",
    "format": "ruff format backend/"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
