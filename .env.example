BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# "development" or "production" (production enforces a strong JWT secret at startup)
ENVIRONMENT=development
# Comma-separated origin allowlist for CORS (leave empty for dev; REQUIRED in production)
CORS_ORIGINS=http://localhost:5173
# SQLite for zero-config dev (schema auto-created). For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+asyncpg://surya:surya@localhost:5432/surya
# (Postgres schema is managed by Alembic — run `alembic upgrade head` before starting)
DATABASE_URL=sqlite+aiosqlite:///./vpp.db
SIMULATOR_TIME_SCALE=60.0
SIMULATOR_DEFAULT_SCENARIO=mvp_day
ALERT_BATTERY_LOW=20
ALERT_BATTERY_CRITICAL=15
ALERT_GRID_IMPORT_HIGH=500
COST_WEIGHT=0.7
CARBON_WEIGHT=0.3
GRID_EMISSION_FACTOR_KG_PER_KWH=0.74
DEFAULT_TARIFF_BUY_INR=9.0
DEFAULT_TARIFF_SELL_INR=5.0

# Authentication (generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate limiting on /api/v1/auth/* endpoints (requests per minute per IP)
RATE_LIMIT_AUTH_PER_MINUTE=10

# Google Identity Services Web client ID (the same value is used by frontend and backend)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
