BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./vpp.db
SIMULATOR_TIME_SCALE=60.0
SIMULATOR_DEFAULT_SCENARIO=mvp_day
ALERT_BATTERY_LOW=20
ALERT_BATTERY_CRITICAL=15
ALERT_GRID_IMPORT_HIGH=500
COST_WEIGHT=0.7
CARBON_WEIGHT=0.3
GRID_EMISSION_FACTOR_KG_PER_KWH=0.74
DEFAULT_TARIFF_BUY_INR=9.0
DEFAULT_TARIFF_SELL_INR=5.0

# Authentication (generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Identity Services Web client ID (the same value is used by frontend and backend)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Frontend production configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
